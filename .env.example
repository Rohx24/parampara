# Browser-safe values. Anything starting with VITE_ is published in the website code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets. Never give these a VITE_ prefix.
OPENAI_API_KEY=
YOUTUBE_API_KEY=
# Required to use the fine-tuning buttons on /dataset-eval.
ADMIN_TOKEN=
# Optional. The fine-tuned model the app may use.
OPENAI_FINE_TUNED_MODEL=
